PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "RF Power Meter V5 Assistant"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "rf-powermeter-assistant"
            VALUE "OriginalFilename", "rf-powermeter-assistant.exe"
            VALUE "ProductName",      "RF Power Meter V5 Assistant"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
